.ruff_cache/

# AutoDelphiRF working output. `autodelphirf run` writes prepared triangles, replayed
# predictions, and reports here; all of it is regenerated from the raw archive
# plus the dataset config, so none of it belongs in the repository.
autodelphirf_work/
output/
results/

# Experiment definitions (configs and run scripts) are source; their generated
# logs, prepared data, fitted models, and result bundles are local artifacts.
experiments/*/logs/
experiments/*/work/

# Local research materials and data-specific study artifacts. These may contain
# real data, generated reports, fitted outputs, or unpublished thesis work.
/research/
/Jingjing_Thesis-*.pdf
/examples/thesis/
/experiments/
/data/
/reports/
/intermediate/

